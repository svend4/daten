print(response.json())
```

#### Search Documents

```python
url = "http://localhost:8000/api/search/"
headers = {"Authorization": "Bearer YOUR_TOKEN"}

payload = {
    "query": "contract",
    "search_type": "hybrid",
    "limit": 10
}

response = requests.post(url, headers=headers, json=payload)
