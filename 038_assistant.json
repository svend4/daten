## Plugin Development

### Creating a Custom Classifier

```python
from ios_core.services.classifier import ClassifierPlugin

class MyCustomClassifier(ClassifierPlugin):
    """Custom document classifier"""
    
    def classify(self, document):
        # Your classification logic
        if "invoice" in document.content.lower():
            return Classification(
                document_type="Invoice",
                category="Financial",
                confidence=0.95
            )
        
        return None  # Fall back to other classifiers
    
    def train(self, documents):
        # Training logic (optional)
        pass

# Register plugin
from ios_core.plugins import register_classifier
register_classifier(MyCustomClassifier())
```

### Creating a Custom Entity Extractor

```python
from ios_core.services.knowledge_graph import EntityExtractorPlugin

class CompanyExtractor(EntityExtractorPlugin):
    """Extract company names"""
    
    def extract(self, document):
        entities = []
        
        # Your extraction logic
        import re
        companies = re.findall(r'\b([A-Z][a-z]+ (?:Corp|Inc|Ltd|GmbH))\b', document.content)
        
        for company in companies:
            entities.append(Entity(
                type="Company",
                name=company,
                confidence=0.9
            ))
        
        return entities

# Register plugin
from ios_core.plugins import register_entity_extractor
register_entity_extractor(CompanyExtractor())
```

